        "type": "number",
        "unit": "min",
        "required": true,
        "minimum": 0,
        "maximum": 90,
        "labels": {
          "zh-CN": "分区出发延迟",
          "en": "Wave offset"
        }
      },
      {
        "name": "travelMinutes",
        "type": "number",
        "unit": "min",
        "required": true,
        "minimum": 0,
        "maximum": 180,
        "labels": {
          "zh-CN": "通勤与停车时间",
          "en": "Travel and parking time"
        }
      },
      {
        "name": "checkinMinutes",
        "type": "number",
        "unit": "min",
        "required": true,
        "minimum": 0,
        "maximum": 120,
        "labels": {
          "zh-CN": "检录时间",
          "en": "Check-in time"
        }
      },
      {
        "name": "bagDropMinutes",
        "type": "number",
        "unit": "min",
        "required": true,
        "minimum": 0,
        "maximum": 120,
        "labels": {
          "zh-CN": "存包时间",
          "en": "Bag drop time"
