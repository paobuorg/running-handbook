      {
        "name": "arriveClock",
        "type": "string",
        "unit": "HH:MM",
        "required": true,
        "labels": {
          "zh-CN": "到达会场时刻",
          "en": "Arrival time"
        }
      },
      {
        "name": "checkinClock",
        "type": "string",
        "unit": "HH:MM",
        "required": true,
        "labels": {
          "zh-CN": "完成检录时刻",
          "en": "Check-in finish time"
        }
      },
      {
        "name": "bagDropClock",
        "type": "string",
        "unit": "HH:MM",
        "required": true,
        "labels": {
          "zh-CN": "存包结束时刻",
          "en": "Bag drop finish time"
        }
      },
      {
        "name": "warmupClock",
        "type": "string",
        "unit": "HH:MM",
        "required": true,
        "labels": {
          "zh-CN": "热身开始时刻",
          "en": "Warm-up start time"
        }
      },
      {
        "name": "finishClock",
        "type": "string",
        "unit": "HH:MM",
        "required": true,
        "labels": {
          "zh-CN": "预计完赛时刻",
          "en": "Estimated finish time"
        }
      },
      {
        "name": "milestones",
        "type": "array",
        "unit": null,
        "required": true,
        "labels": {
          "zh-CN": "时间轴节点",
          "en": "Timeline milestones"
        }
      }
    ],
    "formulaDescription": "Parse startClock as minutes since midnight (HH:MM, 00:00–23:59); reject malformed clocks. waveOffsetMinutes must be 0–90, travelMinutes 0–180, checkinMinutes 0–120, bagDropMinutes 0–120, warmupMinutes 0–60, finishTargetHours 0–12. effectiveStart = start + waveOffsetMinutes. Warm-up ends at effectiveStart: warmup = effectiveStart − warmupMinutes; bagDrop = warmup − bagDropMinutes; checkin = bagDrop − checkinMinutes; arrive = checkin − 10 fixed on-site buffer; leave = arrive − travelMinutes; wake = leave − 90 fixed wake prep; finish = effectiveStart + finishTargetHours × 60. If any pre-start milestone falls before midnight, it wraps onto the previous day and the milestone is flagged previousDay. milestones list wake, leave, arrive, checkin, bagDrop, warm-up, effective start and finish in race order.",
    "assumptions": [
      "All times are on race morning of the same day; a milestone before midnight wraps to the previous day, but the tool does not model multi-day travel.",
      "The fixed 10-minute on-site buffer and 90-minute wake prep are planning heuristics, not official race requirements; corral close times and shuttle schedules must be checked against the current race guide.",
      "Travel covers door-to-venue movement including parking; it does not model ticket, security, toilet or queue delays that vary by event.",
      "Warm-up is placed immediately before the start; the tool does not rehearse race-pace strides, drills or repeat toilet stops after the warm-up.",
      "Clock windows are projections at the entered durations, not commitments; real race-day congestion can compress every on-site block."
    ],
    "rounding": "All clock times round to the nearest whole minute; finish duration converts hours to whole minutes; no fractional minute is retained in output.",
    "caseRefs": [
      "case-race-day-timeline-typical",
      "case-race-day-timeline-boundary",
      "case-race-day-timeline-invalid"
    ]
  }
